# Required: free key from https://console.groq.com/keys
GROQ_API_KEY=paste_your_groq_key_here

# Optional: model to use (llama-3.3-70b-versatile is smarter, llama-3.1-8b-instant has higher free limits)
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Semantic Scholar key (works without one, but shared access is often rate-limited)
SEMANTIC_SCHOLAR_API_KEY=

# Optional: your email, sent to OpenAlex so requests go to its faster "polite pool"
OPENALEX_EMAIL=
